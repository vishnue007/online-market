# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# MongoDB Database URL
# Local MongoDB: mongodb://localhost:27017/online-market
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/online-market?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/online-market

# JWT Secret (for authentication)
# JWT_SECRET=your-super-secret-jwt-key

# API Keys (add as needed)
# STRIPE_SECRET_KEY=sk_test_...
# SENDGRID_API_KEY=SG...
